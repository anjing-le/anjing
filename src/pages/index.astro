---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/index.css';
---

<BaseLayout title="你好，我是安静" hideHeader>
  <div class="index-page">
    <section class="intro-screen" aria-labelledby="intro-title">
      <div class="container intro-container">
        <h1 id="intro-title" class="intro-accessible-title">安静</h1>
        <div class="intro-character-wrap">
          <span class="intro-cloud intro-cloud--left-top" aria-hidden="true"></span>
          <span class="intro-cloud intro-cloud--left-bottom" aria-hidden="true"></span>
          <img
            class="intro-character"
            src="/assets/ip/anjing-character.png"
            alt="安静的手绘 IP 形象"
            loading="eager"
            decoding="async"
          />
          <span class="intro-cloud intro-cloud--right-top" aria-hidden="true"></span>
          <span class="intro-cloud intro-cloud--right-bottom" aria-hidden="true"></span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
