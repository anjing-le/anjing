---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/index.css';
---

<BaseLayout title="你好，我是安静" hideHeader>
  <div class="index-page">
    <section class="intro-screen" aria-labelledby="intro-title">
      <div class="container intro-container">
        <img
          class="intro-character"
          src="/assets/ip/anjing-character.png"
          alt="安静的手绘 IP 形象"
          loading="eager"
          decoding="async"
        />
        <h1 id="intro-title" class="entry-title">你好，我是<span class="entry-name">安静</span></h1>
      </div>
    </section>
  </div>
</BaseLayout>
