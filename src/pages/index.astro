---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroSpeechCloud from '../components/IntroSpeechCloud.astro';
import '../styles/index.css';
---

<BaseLayout title="你好，我是安静" hideHeader>
  <div class="index-page">
    <section class="intro-screen" aria-labelledby="intro-title">
      <div class="container intro-container">
        <h1 id="intro-title" class="intro-accessible-title">嗨，你好，我是安静</h1>
        <div class="intro-character-wrap">
          <IntroSpeechCloud side="left" />
          <img
            class="intro-character"
            src="/assets/ip/anjing-character.png"
            alt="安静的手绘 IP 形象"
            loading="eager"
            decoding="async"
          />
          <IntroSpeechCloud side="right" />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
