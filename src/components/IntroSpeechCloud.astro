---
interface Props {
  side: 'left' | 'right';
}

const { side } = Astro.props;
---

<svg
  class={`intro-cloud intro-cloud--${side}`}
  viewBox="0 0 260 170"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {side === 'right' && (
    <defs>
      <pattern id="intro-name-crayon" width="23" height="21" patternUnits="userSpaceOnUse">
        <rect width="23" height="21" fill="#ffd12b" />
        <path
          d="M2 4l3-1 M11 2l2 1 M19 6l2-1 M5 12l3-1 M15 10l3 1 M2 19l2-1 M11 17l3-1 M20 18l2-1"
          stroke="#fff2a4"
          stroke-width="1.6"
          stroke-linecap="round"
          opacity="0.9"
        />
        <path
          d="M7 5l2 1 M17 3l2-1 M1 9l2 1 M10 13l2-1 M20 13l2 1 M6 18l2 1 M16 19l2-1"
          stroke="#eab223"
          stroke-width="1.1"
          stroke-linecap="round"
          opacity="0.65"
        />
      </pattern>
    </defs>
  )}
  <path
    d="M 28 83 C 15 72 18 51 34 42 C 38 26 56 16 76 22 C 94 8 122 11 136 24 C 157 13 184 22 193 39 C 213 36 235 50 233 68 C 247 82 242 105 223 114 C 223 125 236 133 250 136 C 235 141 218 137 208 129 C 191 144 164 147 145 136 C 123 147 96 143 82 133 C 59 136 39 124 35 106 C 25 100 22 91 28 83 Z"
    transform={side === 'right' ? 'translate(260 0) scale(-1 1)' : undefined}
    fill="rgba(255, 255, 255, 0.38)"
    stroke="rgba(76, 66, 58, 0.52)"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <text
    class="intro-cloud__message"
    x="130"
    y="81"
    fill="#4c423a"
    font-size="31"
    font-weight="400"
    letter-spacing="1"
    text-anchor="middle"
    dominant-baseline="middle"
  >{side === 'left' ? '嗨，你好' : <>我是<tspan class="intro-cloud__name" fill="url(#intro-name-crayon)">安静</tspan></>}</text>
</svg>
